{
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251001.0",
    "@types/node": "^26.6.6",
    "bun-types": "^1.4.4",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "wrangler": "^3.114.0"
  },
  "name": "intel-terminal-api",
  "private": true,
  "scripts": {
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:seed": "bun scripts/make_seed.ts",
    "int1": "bun scripts/int1.ts",
    "test": "bun test",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "migrate": "wrangler d1 execute intel-terminal --local --file=./sql/schema.sql",
    "seed": "wrangler d1 execute intel-terminal --local --file=./sql/seed.sql",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "version": "0.1.0",
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "hono": "^4.13.14",
    "zod": "^4.6.7"
  }
}
